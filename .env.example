# Copiar a .env.local y completar con tus keys de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# SOLO servidor (nunca la expongas en el navegador). Necesaria para leer/crear
# reservas y operar MercadoPago sin exponer datos personales vía RLS.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# MercadoPago — Access Token SOLO servidor (sin NEXT_PUBLIC_), Public Key pública
MP_ACCESS_TOKEN=tu-access-token
NEXT_PUBLIC_MP_PUBLIC_KEY=tu-public-key
# En Vercel: https://tunumero.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
